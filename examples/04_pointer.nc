module main
use stdio

/* ============================================================
 * 04_pointer — 指针与解引用
 *
 * 演示：& 取地址 / p.() 解引用（读写，一元 * 解引用已在 1.0.x 移除）/
 *       指针隐式类型推断（p = &x 自动推断为指向 x 的指针）
 * 1.0 可编译：是（c/native 后端）
 * ============================================================ */

func main() {
    x i32 = 42

    /* 取地址：p 由 &x 自动推断为指向 i32 的指针 */
    p = &x

    /* 解引用写 */
    p.() = 43
    y i32 = p.()
    if y == 43 {
        puts("deref write ok")
    } else {
        puts("deref write bad")
    }

    /* 解引用：经中间变量取地址再 .() 读（一元 * 解引用已在 1.0.x 移除，统一用 .()） */
    px = &x
    z i32 = px.()
    if z == 43 {
        puts("addr deref ok")
    } else {
        puts("addr deref bad")
    }
}
