module main

/* 动态数组语法四后端一致性回归（2026-09-01）
 * 背景：BNF §3 / Chinese.md / English.md 规定写法是 [N...]，但 A 方案早期只实现
 * 了 [...N]，IR 前端只实现 [N...] —— 两套前端互不兼容，且文档示例在 1.0 产品线
 * 编译不过。本轮两边都接受全部写法（[N...] 为规范，[...N] 为历史兼容），
 * 用本用例锁死四后端语义一致。
 * 注：本用例在 IR_SUBSET（四后端通用），故不使用 len()（A 方案无此内置）
 *     也不使用 `p void = ...`（A 方案不支持无类型变量声明）。 */

func main() {
    /* [N...]：BNF 规范的动态数组写法（1.0 语义：固定容量 N，不自动增长） */
    a i32[6...] = {10, 20, 30, 40, 50, 60}
    if a[0] == 10 && a[5] == 60 {
        puts("N... ok")
    } else {
        puts("N... bad")
    }

    /* [N..]：.. 与 ... 等价 */
    b i32[3..] = {1, 2, 3}
    b[2] = 99
    if b[2] == 99 {
        puts("N.. ok")
    } else {
        puts("N.. bad")
    }

    /* [...N]：历史兼容写法，等同 [N...] */
    c i16[...4] = {1, 2, 3, 4}
    if c[3] == 4 {
        puts("...N ok")
    } else {
        puts("...N bad")
    }

    /* [...]：未指定容量 → 默认 8 槽（与 IR 前端一致） */
    d i8[...] = {1, 2, 3}
    d[1] = 7
    if d[0] == 1 && d[1] == 7 && d[2] == 3 {
        puts("bare ok")
    } else {
        puts("bare bad")
    }

    /* 动态数组参与循环累加 */
    i i32 = 0
    sum i32 = 0
    while i < 6 {
        sum += a[i]
        i++
    }
    if sum == 210 {
        puts("sum ok")
    } else {
        puts("sum bad")
    }

    /* 与固定数组 [N] 同语义（1.0 两者生成的存储一致） */
    e i32[2] = {5, 6}
    if e[1] == 6 {
        puts("fixed ok")
    } else {
        puts("fixed bad")
    }
    return
}
